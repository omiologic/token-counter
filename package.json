{
  "name": "@omiologic/token-counter",
  "description": "Portable, local-first token measurement for JavaScript and TypeScript applications.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "browser": "./dist/core.js",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./js": {
      "types": "./dist/js.d.ts",
      "browser": "./dist/js.js",
      "import": "./dist/js.js",
      "default": "./dist/js.js"
    },
    "./encodings/cl100k_base": {
      "types": "./dist/encodings/cl100k_base.d.ts",
      "browser": "./dist/encodings/cl100k_base.js",
      "import": "./dist/encodings/cl100k_base.js",
      "default": "./dist/encodings/cl100k_base.js"
    },
    "./encodings/gpt2": {
      "types": "./dist/encodings/gpt2.d.ts",
      "browser": "./dist/encodings/gpt2.js",
      "import": "./dist/encodings/gpt2.js",
      "default": "./dist/encodings/gpt2.js"
    },
    "./encodings/o200k_base": {
      "types": "./dist/encodings/o200k_base.d.ts",
      "browser": "./dist/encodings/o200k_base.js",
      "import": "./dist/encodings/o200k_base.js",
      "default": "./dist/encodings/o200k_base.js"
    },
    "./encodings/p50k_base": {
      "types": "./dist/encodings/p50k_base.d.ts",
      "browser": "./dist/encodings/p50k_base.js",
      "import": "./dist/encodings/p50k_base.js",
      "default": "./dist/encodings/p50k_base.js"
    },
    "./encodings/p50k_edit": {
      "types": "./dist/encodings/p50k_edit.d.ts",
      "browser": "./dist/encodings/p50k_edit.js",
      "import": "./dist/encodings/p50k_edit.js",
      "default": "./dist/encodings/p50k_edit.js"
    },
    "./encodings/r50k_base": {
      "types": "./dist/encodings/r50k_base.d.ts",
      "browser": "./dist/encodings/r50k_base.js",
      "import": "./dist/encodings/r50k_base.js",
      "default": "./dist/encodings/r50k_base.js"
    },
    "./workers/cl100k_base": {
      "types": "./dist/workers/cl100k_base.d.ts",
      "browser": "./dist/workers/cl100k_base.js",
      "import": "./dist/workers/cl100k_base.js",
      "default": "./dist/workers/cl100k_base.js"
    },
    "./workers/gpt2": {
      "types": "./dist/workers/gpt2.d.ts",
      "browser": "./dist/workers/gpt2.js",
      "import": "./dist/workers/gpt2.js",
      "default": "./dist/workers/gpt2.js"
    },
    "./workers/o200k_base": {
      "types": "./dist/workers/o200k_base.d.ts",
      "browser": "./dist/workers/o200k_base.js",
      "import": "./dist/workers/o200k_base.js",
      "default": "./dist/workers/o200k_base.js"
    },
    "./workers/p50k_base": {
      "types": "./dist/workers/p50k_base.d.ts",
      "browser": "./dist/workers/p50k_base.js",
      "import": "./dist/workers/p50k_base.js",
      "default": "./dist/workers/p50k_base.js"
    },
    "./workers/p50k_edit": {
      "types": "./dist/workers/p50k_edit.d.ts",
      "browser": "./dist/workers/p50k_edit.js",
      "import": "./dist/workers/p50k_edit.js",
      "default": "./dist/workers/p50k_edit.js"
    },
    "./workers/r50k_base": {
      "types": "./dist/workers/r50k_base.d.ts",
      "browser": "./dist/workers/r50k_base.js",
      "import": "./dist/workers/r50k_base.js",
      "default": "./dist/workers/r50k_base.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "analyze:bundles": "node test/analyze-bundles.mjs",
    "build": "tsc --project tsconfig.json",
    "build:test-browser": "node test/build-browser-tests.mjs",
    "test": "npm run test:node && npm run test:browser && npm run test:cdn",
    "test:browser": "npm run build && npm run build:test-browser && node test/run-browser-tests.mjs",
    "test:cdn": "npm run build && node --test test/cdn-layout.test.mjs && node test/run-cdn-browser-tests.mjs",
    "test:csp": "npm run build && node test/run-browser-csp-tests.mjs",
    "test:fuzz": "npm run build && node test/run-fuzz.mjs && npm run build:test-browser && node test/run-browser-tests.mjs",
    "test:fuzz:case": "npm run build && node test/run-fuzz-case.mjs",
    "test:fuzz:reference": "npm run build && node test/run-fuzz-reference.mjs",
    "test:node": "npm run build && node --test test/browser-worker-races.test.mjs test/bundle-analysis.test.mjs test/encoding-isolation.test.mjs test/fuzz.test.mjs test/isolated-bundles.test.mjs test/isolated-encodings.test.mjs test/js-tiktoken.test.mjs test/package-surface.test.mjs test/parity.test.mjs test/public-output.test.mjs test/registry.test.mjs test/worker-bundles.test.mjs",
    "test:reproducibility": "node test/reproducible-package.mjs",
    "test:stress": "npm run build && node test/evaluation/evaluate-stress.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "release:check": "npm run typecheck && npm test && npm run test:csp && npm run test:stress && npm run test:reproducibility && npm pack --dry-run",
    "release": "npm publish --access public"
  },
  "dependencies": {
    "js-tiktoken": "1.0.21"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "js-tiktoken": {
      "base64-js": "1.5.1"
    }
  },
  "version": "0.1.0-beta.1"
}
